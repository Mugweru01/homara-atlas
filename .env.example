# Homara Atlas Neon environment
# Server only. Populate with `neon env pull --file .env.local` after linking.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_FUNCTION_ATLAS_BASE_URL=

# Browser only: copy the actual public branch URLs to apps/web/.env.local.
# No database, sealing, storage or CLI secrets may use a VITE_ prefix.
VITE_API_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_REALTIME_URL=
ENVIRONMENT=development

# Backend only: provision with scripts/provision-backend.mjs; never expose to browsers.
ATLAS_API_DATABASE_URL=
ATLAS_WORKER_DATABASE_URL=
ATLAS_INTERNAL_TOKEN=
ATLAS_RATE_LIMIT_SECRET=
ATLAS_WORKER_BASE_URL=
ATLAS_ALLOWED_ORIGINS=https://atlas.homara.co.ke,https://homara-atlas.vercel.app
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Keep this separate from database/runtime credentials; generate 32 random bytes, base64.
ATLAS_BACKUP_KEY=
